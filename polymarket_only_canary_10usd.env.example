# Polymarket-only $10 canary live template
# 目标:
# - 验证真钱下单/撤单/余额检查/portfolio sync/order sync 链路
# - 不用于验证策略长期收益
#
# 重要限制:
# - 当前代码没有独立的 T3 maker 总开关
# - 因此本模板只能通过极小仓位 + 极低总敞口 + 单一 focus 市场来压低 T3 风险
# - 真钱首测建议全程盯盘

# ---- 钱包与认证 ----
PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_DEPOSIT_WALLET=
# 新 deposit wallet canary: 填 POLYMARKET_DEPOSIT_WALLET 或 POLYMARKET_FUNDER，签名类型用 POLY_1271。
POLYMARKET_SIGNATURE_TYPE=3
CHAIN_ID=137

# ---- 基础端点 ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_CLOB_CLIENT_VERSION=v2

# ---- 交易模式 ----
ARB_DRY_RUN=false
# 实盘双确认：没有这个开关，配置层会拒绝启动 live
LIVE_TRADING_ACK=true
LIVE_REQUIRE_PORTFOLIO_SYNC=true
LIVE_ALLOW_ZERO_TAKER_FEE=false
LIVE_MAX_ORDER_SIZE_USDC=1.5
LIVE_MAX_TOTAL_EXPOSURE_USDC=3.0
LIVE_MIN_NET_EDGE_BPS=35
LIVE_MIN_NET_EDGE_USD=0.0035
LIVE_MAX_ORDERBOOK_SNAPSHOT_AGE_SEC=1
LIVE_MIN_WS_HIT_RATIO=0.35
# T3 做市策略：dry-run 期间打开以验证报价行为；切实盘前重新评估
MAKER_STRATEGY_ENABLED=true

# ---- 套利筛选 ----
# 10 USDC canary 的目标是“少交易、慢一点、看链路”
ARB_MIN_EDGE_USD=0.01
ARB_MIN_EDGE_PCT=0.8
ARB_DEFAULT_ORDER_SIZE_USDC=1.0
ARB_MAX_ORDER_SIZE_USDC=1.5
ARB_SCAN_INTERVAL_SEC=5
ARB_MARKET_FETCH_LIMIT=300
ARB_MARKET_UNIVERSE_REFRESH_SEC=600
# 观测期：放开关键词、扩大热池，让 T2 看到 >1 个市场的信号
ARB_MARKET_FOCUS_KEYWORDS=
ARB_HOT_MARKET_POOL_SIZE=200
ARB_HOT_EVENT_POOL_SIZE=50
ARB_MIN_LIQUIDITY=1000
ARB_MIN_VOLUME_24H=500
ORDERBOOK_SNAPSHOT_TTL_SEC=0.3
ORDERBOOK_WS_SNAPSHOT_MAX_AGE_SEC=1
ORDERBOOK_RETRY_COUNT=2
ORDERBOOK_RETRY_DELAY_SEC=0.15
ORDERBOOK_MISSING_COOLDOWN_SEC=300
# 默认空；填入 data/cross_platform/pairs.example.json 里的配对后启用 T1
CROSS_PLATFORM_PAIRS_JSON=
# Polymarket 现行 feeSchedule.rate 为 0.03 (sports) / 0.05 (general/culture)。
# 资源解析器 models.resolve_polymarket_fee_rate 会优先读取每个市场的 feeSchedule.rate，
# 这里的 env 默认值只是 fallback。设为 0.05 是更高一档的保守估计。
# 实盘前用 `python -m scripts.verify_polymarket_fees --limit 100` 确认当前分布。
POLYMARKET_TAKER_FEE_RATE=0.05
KALSHI_TAKER_FEE_RATE=0.003
ARB_MAX_MULTI_OUTCOME_LEGS=20
T0_MIN_MULTI_OUTCOME_MEDIAN_LEG_PRICE=0.05

# ---- 风控 ----
# 小资金 canary：允许 2-3 个不同市场的小仓位，避免被 single-market 信号垄断
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_EXPOSURE_PER_MARKET=1.5
RISK_MAX_TOTAL_EXPOSURE=3.0
RISK_MAX_DAILY_LOSS=1.0
RISK_MAX_CONSECUTIVE_FAILURES=2
RISK_EVENT_COOLDOWN_SEC=180
RISK_PENDING_RESERVATION_TTL_SEC=60
RISK_HALT_AUTO_RECOVER_SEC=3600
# 缩短挂单寿命，尽快验证 cancel_stale_maker_orders 链路
MAKER_STALE_ORDER_TTL_SEC=30

# ---- 账户同步 ----
PORTFOLIO_SYNC_ENABLED=true
PORTFOLIO_SYNC_INTERVAL_SEC=60
PORTFOLIO_SYNC_TIMEOUT_SEC=5
# 连续 N 次同步失败后自动暂停开仓（live 模式生效），下次同步成功自动恢复
PORTFOLIO_SYNC_MAX_CONSECUTIVE_FAILURES=3
DATA_API_HOST=https://data-api.polymarket.com
PORTFOLIO_SYNC_USER_ADDRESS=

# ---- 波动率 / Edge / T2 ----
VOL_FAST_MINUTES=60
VOL_SLOW_MINUTES=360
VOL_MIN_BARS=20
EDGE_MIN_BPS=150
EDGE_MAX_SPREAD_BPS=300
EDGE_MIN_CONFIDENCE=0.55
EDGE_CONFIDENCE_FULL_BPS=500
EDGE_CONFIDENCE_IMBALANCE_WEIGHT=0.1
EDGE_VOLATILITY_SPIKE_RATIO=2.0
EDGE_VOLATILITY_SPIKE_PENALTY=0.7
EDGE_VOLATILITY_CALM_RATIO=0.8
EDGE_VOLATILITY_CALM_BOOST=1.1
T2_MIN_DEVIATION=0.015
T2_MAX_SPREAD_BPS=120
T2_MIN_TOP_DEPTH=100
T2_MAX_COMPLEMENT_ERROR_BPS=150
# 单市场每小时最多 N 条信号；防止同一 mispricing 反复刷信号
T2_MAX_SIGNALS_PER_MARKET_PER_HOUR=2

# ---- T2 退出策略 ----
# 入场后任一信号触发即 SELL：止损 / 止盈 / 时间止损 / Bellman optimal stopping
T2_STOP_LOSS_BPS=300
T2_TAKE_PROFIT_CAPTURE_PCT=0.6
T2_MAX_HOLD_SEC=21600
T2_EXIT_EVAL_INTERVAL_SEC=30
T2_OPTIMAL_STOPPING_ENABLED=true

# ---- WebSocket ----
WS_ENABLED=true
WS_MAX_MARKETS=10
WS_REFRESH_CYCLES=100
WS_VOL_FEED_INTERVAL_SEC=30

# ---- 录制 / 观测 ----
TICK_RECORD_ENABLED=true
TICK_RECORD_DIR=data/ticks
TELEMETRY_RECORD_ENABLED=true
TELEMETRY_RECORD_DIR=data/telemetry

# ---- 定期清理 ----
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INTERVAL_SEC=3600
DATA_TICKS_RETENTION_DAYS=7
DATA_TICKS_MAX_GB=2
DATA_TELEMETRY_RETENTION_DAYS=14
DATA_TELEMETRY_MAX_GB=1
DATA_RESEARCH_CACHE_RETENTION_DAYS=14
DATA_RESEARCH_CACHE_MAX_GB=1
DATA_BACKTEST_RETENTION_DAYS=30
DATA_BACKTEST_MAX_GB=1

# ---- Dashboard / 日志 ----
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8077
LOG_LEVEL=INFO
LOG_FILE=arb_bot.log

# ---- 通知 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OPEN_ID=
FEISHU_API_BASE=https://open.feishu.cn/open-apis
NOTIFICATION_COOLDOWN_SEC=30
NOTIFY_ON_ARB_FOUND=false
NOTIFY_ON_TRADE_SUCCESS=true
NOTIFY_ON_TRADE_FAILURE=true
NOTIFY_ON_FATAL_ERROR=true
NOTIFY_ON_PNL_ALERT=true
NOTIFY_ON_DAILY_SUMMARY=true
PNL_PROFIT_ALERT_USDC=1
PNL_LOSS_ALERT_USDC=0.5
FATAL_ERROR_COOLDOWN_SEC=300
DAILY_SUMMARY_TIME_HHMM=08:05
DAILY_SUMMARY_TIMEZONE=Asia/Shanghai
NOTIFICATION_STATE_FILE=data/telemetry/notification_state.json

# ---- AI / Research ----
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE=
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.1
AI_EVAL_INTERVAL_SEC=30
AI_MAX_COST_PER_DAY=1.0
AI_OVERRIDE_RISK=false
AI_AUTO_RECOVER_SEC=1800

# canary 首测建议先关掉 research overlay，降低额外变量
RESEARCH_SIGNAL_ENABLED=false
RESEARCH_SIGNAL_WINDOW_SEC=86400
RESEARCH_SIGNAL_MAX_ITEMS=5
RESEARCH_SIGNAL_CACHE_TTL_SEC=300
RESEARCH_SIGNAL_CACHE_DIR=data/research_signal
RESEARCH_SIGNAL_EXTRA_RSS_FEEDS=
RESEARCH_SIGNAL_HTTP_JSON_SOURCES=
RESEARCH_SIGNAL_SURF_ENABLED=false
RESEARCH_SIGNAL_SURF_API_KEY=
RESEARCH_SIGNAL_SURF_API_BASE=https://api.asksurf.ai/surf-ai
RESEARCH_SIGNAL_SURF_MODEL=surf-1.5-instant
RESEARCH_SIGNAL_SURF_TIMEOUT_SEC=8
RESEARCH_SIGNAL_SURF_CACHE_TTL_SEC=1800
RESEARCH_SIGNAL_KNOWLEDGE_ENABLED=false
RESEARCH_SIGNAL_KNOWLEDGE_DIR=data/research_signal/knowledge
RESEARCH_SIGNAL_KNOWLEDGE_MAX_MATCHES=3

# ---- Backtest ----
BACKTEST_ENABLED=false
BACKTEST_DATA_DIR=data/backtest
BACKTEST_DEFAULT_DATASET=default
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_REPORTS_DIR=research/backtest/output
