# ============================================================
# 服务器连续观测模板（建议先跑 3-7 天）
# 目标：收集机会/执行/订单簿/AI上下文数据，评估是否存在稳定套利
# ============================================================

# ---- 钱包与认证 ----
PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=2
CHAIN_ID=137

# ---- 基础端点 ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ---- 观测模式：先不开真钱 ----
ARB_DRY_RUN=true

# ---- 套利筛选：先保守，过滤噪音 ----
ARB_MIN_EDGE_USD=0.01
ARB_MIN_EDGE_PCT=0.6
ARB_MAX_ORDER_SIZE_USDC=20.0
ARB_DEFAULT_ORDER_SIZE_USDC=5.0
ARB_SCAN_INTERVAL_SEC=3
ARB_MARKET_FETCH_LIMIT=100
ARB_MARKET_UNIVERSE_REFRESH_SEC=600
ARB_HOT_MARKET_POOL_SIZE=80
ARB_HOT_EVENT_POOL_SIZE=30
# 例如: btc,bitcoin,crypto；为空表示全市场
ARB_MARKET_FOCUS_KEYWORDS=btc,bitcoin,crypto,eth,ethereum,sol,solana,arb,altcoin
ARB_MIN_LIQUIDITY=1500
ARB_MIN_VOLUME_24H=1000
ORDERBOOK_SNAPSHOT_TTL_SEC=0.3
POLYMARKET_TAKER_FEE_RATE=0.02
KALSHI_TAKER_FEE_RATE=0.003

# ---- 风控：观测期先压小 ----
RISK_MAX_OPEN_POSITIONS=3
RISK_MAX_EXPOSURE_PER_MARKET=20.0
RISK_MAX_TOTAL_EXPOSURE=50.0
RISK_MAX_DAILY_LOSS=10.0
RISK_MAX_CONSECUTIVE_FAILURES=3
RISK_EVENT_COOLDOWN_SEC=60

# ---- WebSocket / Vol ----
WS_ENABLED=true
WS_MAX_MARKETS=5
WS_REFRESH_CYCLES=100
WS_VOL_FEED_INTERVAL_SEC=30
VOL_FAST_MINUTES=60
VOL_SLOW_MINUTES=360
VOL_MIN_BARS=20

# ---- Edge ----
EDGE_MIN_BPS=100
EDGE_MAX_SPREAD_BPS=500
EDGE_MIN_CONFIDENCE=0.4
EDGE_CONFIDENCE_FULL_BPS=500
EDGE_CONFIDENCE_IMBALANCE_WEIGHT=0.1
EDGE_VOLATILITY_SPIKE_RATIO=2.0
EDGE_VOLATILITY_SPIKE_PENALTY=0.7
EDGE_VOLATILITY_CALM_RATIO=0.8
EDGE_VOLATILITY_CALM_BOOST=1.1

# ---- 录制：关键 ----
TICK_RECORD_ENABLED=true
TICK_RECORD_DIR=data/ticks
TELEMETRY_RECORD_ENABLED=true
TELEMETRY_RECORD_DIR=data/telemetry

# ---- 定期清理，避免服务器长期运行占满磁盘 ----
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INTERVAL_SEC=3600
DATA_TICKS_RETENTION_DAYS=7
DATA_TICKS_MAX_GB=6
DATA_TELEMETRY_RETENTION_DAYS=14
DATA_TELEMETRY_MAX_GB=2
DATA_RESEARCH_CACHE_RETENTION_DAYS=14
DATA_RESEARCH_CACHE_MAX_GB=1
DATA_BACKTEST_RETENTION_DAYS=30
DATA_BACKTEST_MAX_GB=1

# ---- Dashboard / 日志 ----
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8077
LOG_LEVEL=INFO
LOG_FILE=arb_bot.log

# ---- AI：观测期建议先关，只收数据 ----
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE=
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.1
AI_EVAL_INTERVAL_SEC=30
AI_MAX_COST_PER_DAY=5.0
AI_OVERRIDE_RISK=false
AI_AUTO_RECOVER_SEC=1800

# ---- Research Signal：建议打开，给后续 AI 分析留上下文 ----
RESEARCH_SIGNAL_ENABLED=true
RESEARCH_SIGNAL_WINDOW_SEC=86400
RESEARCH_SIGNAL_MAX_ITEMS=5
RESEARCH_SIGNAL_CACHE_TTL_SEC=300
RESEARCH_SIGNAL_CACHE_DIR=data/research_signal
RESEARCH_SIGNAL_EXTRA_RSS_FEEDS=
RESEARCH_SIGNAL_KNOWLEDGE_ENABLED=true
RESEARCH_SIGNAL_KNOWLEDGE_DIR=data/research_signal/knowledge
RESEARCH_SIGNAL_KNOWLEDGE_MAX_MATCHES=3

# ---- Backtest ----
BACKTEST_ENABLED=false
BACKTEST_DATA_DIR=data/backtest
BACKTEST_DEFAULT_DATASET=default
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_REPORTS_DIR=research/backtest/output

# ---- Telegram 可选 ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_ARB_FOUND=true
TELEGRAM_NOTIFY_ON_TRADE=true
TELEGRAM_NOTIFY_ON_ERROR=true
TELEGRAM_NOTIFY_COOLDOWN_SEC=30
