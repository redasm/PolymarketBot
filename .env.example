# ============================================================
# Polymarket arbitrage bot — configuration template
#
# Copy to .env and fill in real values. .env is gitignored; NEVER commit it.
# A leaked PRIVATE_KEY drains the wallet immediately and irreversibly.
#
# The inline comments below are in Chinese. The English reference for every
# setting here is doc/en/configuration.md (Chinese: doc/zh/configuration.md).
#
# ARB_DRY_RUN defaults to true. Real orders additionally require
# LIVE_TRADING_ACK=true — both, or the process exits at the safety check.
#
# ------------------------------------------------------------
# Polymarket 套利机器人统一配置模板
# 复制为 .env 并填写真实值（.env 已在 .gitignore 中）
#
# 运行模式：
# 推荐用 `python scripts/run_automated_quant_pipeline.py --dotenv-path .env`
# 拉起一份 bot 主循环 + 多个旁路数据进程：
# - bot 按 ARB_DRY_RUN 决定 dry-run/live；live 内部有 shadow-only 候选验证通道
# - logical-rules/event-baselines workers 用 LLM 生成热加载 JSON，不阻塞主循环
# - scanner 持续自动发现钱包观察，独立周期，不阻塞 bot 扫描
# - promoter 持续从 shadow telemetry 晋级通过验证的钱包，独立周期
# 只想运行 bot + 两条 LLM 输入旁路时，可用：
# `python run_bot_with_llm_inputs.py --dotenv-path .env`
# 直接单进程启动时，ARB_DRY_RUN 仍控制该进程是 shadow 还是 live。
#
# 默认资金分配（StrategyOrchestrator，Polymarket 单平台不开 T1）：
# - T0 结构性套利: 35%
# - T1 跨平台:     10%
# - T2 统计套利:   35%
# - T3 做市:       20%
# ============================================================

# ---- 钱包与认证 ----
PRIVATE_KEY=
# 旧 Safe/Proxy 用户填 Polymarket 设置页里的 proxy/Safe 地址。
POLYMARKET_FUNDER=
# 新 deposit wallet 用户也可改填 POLYMARKET_DEPOSIT_WALLET；代码会把它作为 funder。
POLYMARKET_DEPOSIT_WALLET=
# 签名类型: 0=EOA, 1=Magic/Email, 2=Browser/Gnosis Safe, 3=Deposit Wallet/POLY_1271
POLYMARKET_SIGNATURE_TYPE=2

# ---- CLOB / Gamma 端点 ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137
# auto 优先尝试 py-clob-client-v2，缺失时回退旧 py-clob-client；deposit wallet 必须用 auto 或 v2
POLYMARKET_CLOB_CLIENT_VERSION=auto
# 可选：已创建的 CLOB L2 API 凭证；留空时客户端会尝试基于 PRIVATE_KEY 派生/创建
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

# ---- 套利参数 ----
# 最小套利利润（美元）低于此值不执行
ARB_MIN_EDGE_USD=0.005
# 最小套利利润率（%）低于此值不执行
ARB_MIN_EDGE_PCT=0.3
# 单笔最大下单量（USDC）
ARB_MAX_ORDER_SIZE_USDC=50.0
# 默认下单量（USDC）
ARB_DEFAULT_ORDER_SIZE_USDC=10.0
# 主循环扫描间隔（秒）
ARB_SCAN_INTERVAL_SEC=5
# P0-dirty: 累计多少个市场出现 best 变化后立刻打断 scan_interval 等待。
# 1 = 任一变化即唤醒（最低延迟，CPU 占用略高），>1 用于把唤醒批处理。
DIRTY_MARKET_WAKE_THRESHOLD=1
# Gamma API 拉取市场的批量大小
ARB_MARKET_FETCH_LIMIT=100
# 全市场 universe 刷新周期（秒），主循环平时只扫热池
ARB_MARKET_UNIVERSE_REFRESH_SEC=600
# 高频扫描的热市场池大小
ARB_HOT_MARKET_POOL_SIZE=80
# 高频扫描的热事件池大小
ARB_HOT_EVENT_POOL_SIZE=30
# 可选主题过滤，逗号分隔；为空表示全市场
# 服务器观测期常见做法：
# - 想先聚焦 crypto：btc,bitcoin,crypto,ethereum,eth,solana,sol,altcoin
# - 想做全市场对照：留空
ARB_MARKET_FOCUS_KEYWORDS=
# 是否只扫描不执行（dry run 模式）
ARB_DRY_RUN=true
# 实盘双确认：只有 ARB_DRY_RUN=false 且 LIVE_TRADING_ACK=true 才允许真钱下单
LIVE_TRADING_ACK=false
LIVE_REQUIRE_PORTFOLIO_SYNC=true
LIVE_ALLOW_ZERO_TAKER_FEE=false
LIVE_MAX_ORDER_SIZE_USDC=10.0
LIVE_MAX_TOTAL_EXPOSURE_USDC=100.0
# live-only 安全垫：扣费后 edge 仍需同时超过 bps 与美元门槛
LIVE_MIN_NET_EDGE_BPS=25
LIVE_MIN_NET_EDGE_USD=0.0025
# live-only 行情健康闸门：过旧 WS 快照或 WS 命中率过低时拒绝下单
# 默认 5s：Polymarket 仅在价格变动时推送，安静市场可合理沉默数秒；
# 该值会按 *当前信号涉及的 token* 单独判定，不再因单个空闲 token 拖垮全局
LIVE_MAX_ORDERBOOK_SNAPSHOT_AGE_SEC=5
LIVE_MIN_WS_HIT_RATIO=0.25
# 小额实盘首测建议先关 T3 做市，避免 post-only/GTC 行为成为额外变量
MAKER_STRATEGY_ENABLED=true
# T3 做市退出闸门：超时强平 / 止盈 / 止损（默认值与 .env 一致，留空走代码默认）
MAKER_MAX_HOLD_SEC=21600
MAKER_STOP_LOSS_BPS=300
MAKER_TAKE_PROFIT_BPS=200
MAKER_EXIT_EVAL_INTERVAL_SEC=30
# 最小市场流动性筛选（USDC）
ARB_MIN_LIQUIDITY=1000
# 最小24h交易量筛选（USDC）
ARB_MIN_VOLUME_24H=500
# 订单簿 REST 快照缓存 TTL（秒），用于缓解高频扫描时的重复拉单
ORDERBOOK_SNAPSHOT_TTL_SEC=5
# WS 快照最大可用年龄（秒），超过后降级为 REST
ORDERBOOK_WS_SNAPSHOT_MAX_AGE_SEC=10
# REST 获取失败时的重试次数与间隔
ORDERBOOK_RETRY_COUNT=2
ORDERBOOK_RETRY_DELAY_SEC=0.15
# 当 CLOB 明确返回 “No orderbook exists” 时，对该 token 的冷却时长
ORDERBOOK_MISSING_COOLDOWN_SEC=300
# 批量预取订单簿时 REST 兜底的并发数（WS 未覆盖的 token 逐个串行拉会让单周期拖到数分钟）
ORDERBOOK_BATCH_CONCURRENCY=16
# 跨平台套利配对（JSON 数组）；为空表示关闭 T1 扫描
# 建议先把 T0/T2/T3 telemetry 跑顺，再启用 T1
CROSS_PLATFORM_PAIRS_JSON=
# Kalshi 费率默认取约 0.3%，建议结合真实成交单核实
KALSHI_TAKER_FEE_RATE=0.003
# 多结果套利最大腿数；超过此数跳过整个事件
ARB_MAX_MULTI_OUTCOME_LEGS=20
# 多结果套利腿价格中位数最小值；低于此值视为无流动性假信号
T0_MIN_MULTI_OUTCOME_MEDIAN_LEG_PRICE=0.05

# ---- 风险管理 ----
# 最大同时持仓数量
RISK_MAX_OPEN_POSITIONS=10
# 单市场最大敞口（USDC）
RISK_MAX_EXPOSURE_PER_MARKET=100.0
# 全局最大敞口（USDC）
RISK_MAX_TOTAL_EXPOSURE=500.0
# 最大单日亏损（USDC），触发后停止交易
RISK_MAX_DAILY_LOSS=50.0
# 连续失败次数上限，触发后暂停
RISK_MAX_CONSECUTIVE_FAILURES=5
# 同一事件两次套利之间的冷却时间（秒）
RISK_EVENT_COOLDOWN_SEC=60
# pending 订单预留敞口的保留时间（秒）
# 如果未来启用可能较久 pending 的订单，服务器观测期可考虑调高到 120-300
RISK_PENDING_RESERVATION_TTL_SEC=30
# 熔断后无新失败多少秒可自动解除（0=永不自动恢复）
RISK_HALT_AUTO_RECOVER_SEC=3600
# T3 做市挂单超时阈值：超过该秒数仍未成交的 live GTC/post_only 订单会被自动撤销并释放预留敞口
MAKER_STALE_ORDER_TTL_SEC=60
# 是否同步真实账户持仓与当日已实现盈亏（低频，不参与高频盘口路径）
PORTFOLIO_SYNC_ENABLED=false
# 账户同步周期（秒）
PORTFOLIO_SYNC_INTERVAL_SEC=60
# 账户同步请求超时（秒）
PORTFOLIO_SYNC_TIMEOUT_SEC=5
# 实盘下连续 N 次同步失败后暂停开仓，下次成功同步自动恢复
PORTFOLIO_SYNC_MAX_CONSECUTIVE_FAILURES=3
# Polymarket Data API
DATA_API_HOST=https://data-api.polymarket.com
# 可选：显式指定要查询的账户地址；留空则默认用 POLYMARKET_FUNDER
PORTFOLIO_SYNC_USER_ADDRESS=

# ---- 通知路由 / 飞书应用机器人 ----
# 只要填了完整飞书应用机器人配置，就会自动启用通知；否则自动关闭
# 飞书应用机器人凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 单个固定接收目标（只支持 open_id）
FEISHU_OPEN_ID=
# 飞书开放平台 API 基础地址
FEISHU_API_BASE=https://open.feishu.cn/open-apis
# 同类通知冷却时间（秒）
NOTIFICATION_COOLDOWN_SEC=30
# 是否开启“发现机会”类通知。默认关闭，避免刷屏
NOTIFY_ON_ARB_FOUND=false
# Shadow / dry-run 模式下是否仍推送"发现机会"。默认 false：
# 模拟模式不产生真实成交，每条机会都推会刷屏；显式开启时所有 shadow
# 推送会自动加上 🌓 [SHADOW] 前缀
NOTIFY_ARB_FOUND_IN_SHADOW=false
# 成交成功提醒
NOTIFY_ON_TRADE_SUCCESS=true
# 成交失败提醒
NOTIFY_ON_TRADE_FAILURE=true
# 严重错误提醒（API 连续错误 / 风控熔断 等）
NOTIFY_ON_FATAL_ERROR=true
# 盈亏阈值提醒（基于当前已记录 daily_pnl）
NOTIFY_ON_PNL_ALERT=true
# 每日汇总提醒
NOTIFY_ON_DAILY_SUMMARY=true
# 日盈利达到阈值时提醒（USDC）
PNL_PROFIT_ALERT_USDC=20
# 日亏损达到阈值时提醒（USDC）
PNL_LOSS_ALERT_USDC=10
# 同一类严重错误的冷却时间（秒）
FATAL_ERROR_COOLDOWN_SEC=300
# 每日汇总发送时间。当前风控日切仍按 UTC 口径，默认 08:05 Asia/Shanghai
DAILY_SUMMARY_TIME_HHMM=08:05
DAILY_SUMMARY_TIMEZONE=Asia/Shanghai
# 通知状态文件（用于日报去重、阈值提醒去重、跨重启保留统计）
NOTIFICATION_STATE_FILE=data/telemetry/notification_state.json

# ---- 波动率估算 ----
# 快速波动率窗口（分钟），默认 60
VOL_FAST_MINUTES=60
# 慢速波动率窗口（分钟），默认 360
VOL_SLOW_MINUTES=360
# 最少数据点要求，默认 20
VOL_MIN_BARS=20

# ---- Edge 引擎 ----
# 最小 edge 阈值（基点），低于此值不触发
EDGE_MIN_BPS=100
# 最大可接受 spread（基点）
EDGE_MAX_SPREAD_BPS=500
# 最小置信度
EDGE_MIN_CONFIDENCE=0.4
# 置信度达到满分所需 edge（基点）
EDGE_CONFIDENCE_FULL_BPS=500
# OBI（订单簿不平衡）对置信度的权重
EDGE_CONFIDENCE_IMBALANCE_WEIGHT=0.1
# 波动率突刺比值阈值（fast/slow > ratio 时触发惩罚）
EDGE_VOLATILITY_SPIKE_RATIO=2.0
# 波动率突刺时置信度乘数（< 1 为惩罚）
EDGE_VOLATILITY_SPIKE_PENALTY=0.7
# 波动率平静比值阈值（fast/slow < ratio 时触发加成）
EDGE_VOLATILITY_CALM_RATIO=0.8
# 波动率平静时置信度乘数（> 1 为加成）
EDGE_VOLATILITY_CALM_BOOST=1.1
# T2 统计套利最小偏差阈值（绝对概率差），如 0.05 = 5%
T2_MIN_DEVIATION=0.05
# T2 统计套利质量过滤：双边最大 spread（bps）
T2_MAX_SPREAD_BPS=80
# T2 统计套利质量过滤：盘口顶档最小可成交深度
T2_MIN_TOP_DEPTH=100
# T2 统计套利质量过滤：Yes/No 互补误差上限（bps）
T2_MAX_COMPLEMENT_ERROR_BPS=150
# T2 单市场每小时最多触发的信号数（防止 mispricing 反复刷同一市场）
T2_MAX_SIGNALS_PER_MARKET_PER_HOUR=2
# T2 单轮 cycle 最多写出多少条信号；过多会拖慢 orchestrator 排序与日志
T2_MAX_SIGNALS_PER_CYCLE=30
# 拒绝结算时间过远（>N 天）的 markets，长尾仓位 IRR 不划算
T2_MAX_HORIZON_DAYS=180
# T2 短 horizon UPDOWN 标的（如 btc-updown-15m）：开启后这类现货锚定市场在
# 扫描池 / WS 订阅选择中获得优先级 boost，避免被高 volume 长周期市场挤出。
# 默认关闭——先 shadow 观测确认这类市场能过 T2 质量门（spread/depth）再开。
T2_UPDOWN_ENABLED=false
# UPDOWN 市场的优先级权重（仅 T2_UPDOWN_ENABLED=true 时生效，越大越靠前）
T2_UPDOWN_PRIORITY_BOOST=1.0
# UPDOWN 市场 vol24h≈0，会被 ARB_MIN_VOLUME_24H 在 fetch 阶段滤掉，因此用专门的
# slug 直查（/events?slug={sym}-updown-{w}m-{slot}）绕过 volume 过滤拉进 universe。
# 下面控制探测哪些币种 / 窗口长度(分钟) / 向前看几个窗口。
T2_UPDOWN_SYMBOLS=btc,eth
T2_UPDOWN_WINDOW_MINUTES=15
T2_UPDOWN_SLOTS_AHEAD=4
# T2 退出策略：止损 / 止盈 / 时间止损 / Bellman optimal stopping
T2_STOP_LOSS_BPS=300
T2_TAKE_PROFIT_CAPTURE_PCT=0.6
T2_MAX_HOLD_SEC=21600
T2_EXIT_EVAL_INTERVAL_SEC=30
T2_OPTIMAL_STOPPING_ENABLED=true
# Scale-out tranches (Kobylanski 2009 d-stop > 1-stop). take_profit 和
# optimal_stopping 触发时每次卖出 size_remaining * (1/remaining_tranches)，
# 经过 N 次成功触发后全部平掉。stop_loss / time_stop / floor_dump 仍然
# 一次全平。设为 1 即退化到旧的 1-stop 行为。
T2_SCALE_OUT_TRANCHES=3
# Dynamic stop-loss (ATR-equivalent). Disabled by default — flip on
# only after observing T2_STOP_LOSS_BPS behaviour on shadow data.
# When on: stop_bps = clamp(k * realised_vol_bps, min, max).
T2_STOP_LOSS_DYNAMIC_ENABLED=false
T2_STOP_LOSS_DYNAMIC_K=2.0
T2_STOP_LOSS_MIN_BPS=100
T2_STOP_LOSS_MAX_BPS=1000
# Number of price observations before the dynamic estimator activates;
# below this many ticks the static T2_STOP_LOSS_BPS is used.
T2_STOP_LOSS_DYNAMIC_WARMUP=5
# Extreme-price 闸门（Becker 2025 longshot/favorite tax）：拒入场 p<below / p>above
# BUY YES at price < 0.10 平均 -41% EV；BUY at price > 0.90 同理（吃 favorite tax）
T2_REJECT_PRICE_BELOW=0.10
T2_REJECT_PRICE_ABOVE=0.90
# 长周期市场（>30 天到期）的最小 net_edge 门槛（bps），用于挡掉缓慢回归类信号
T2_LONG_HORIZON_DAYS=30
T2_LONG_HORIZON_MIN_NET_EDGE_BPS=200
# Near-efficient 类目（Finance / Crypto）maker-taker gap 仅 0.17pp，taker fee 会吞掉 edge
# 这里要求 Finance/Crypto 类目 net_edge 必须 ≥ 300 bps 才允许 T2 进单
T2_NEAR_EFFICIENT_MIN_NET_EDGE_BPS=300
# Near-certainty rule (Article 4, Taleb / @stacyonchain). Shadow-mode
# by default — the orchestrator logs `near_certainty.would_apply_*`
# stats but does NOT modify signal size/confidence in production until
# we accumulate enough live samples to validate. Flip
# T2_NEAR_CERTAINTY_SHADOW_MODE=false once offline validation is done.
T2_NEAR_CERTAINTY_SHADOW_MODE=true
T2_NEAR_CERTAINTY_HIGH_THRESHOLD=0.92
T2_NEAR_CERTAINTY_LOW_THRESHOLD=0.08
T2_NEAR_CERTAINTY_SIZE_MULTIPLIER=0.60
T2_NEAR_CERTAINTY_CONFIDENCE_DELTA=-0.08
# Barbell pool (Taleb / Article 4). Split T2 capital into data-driven
# (default ~80%) + tail (default ~15%) buckets. When enabled the
# orchestrator relaxes the tail_risk_high size discount while the
# tail bucket has room, then snaps back to harsh once filled. Default
# OFF — flip on after observing meta.barbell.exposure_usdc over a few
# days of live data. NOTE: in the current build the per-class
# exposure ledger is informational; precise debit on T2 settlement
# requires further plumbing (signal_id thread-through). Safe to
# enable in shadow / observation modes.
T2_BARBELL_ENABLED=false

# Weather T2 (Open-Meteo GFS ensemble, opt-in; keep dry-run until settlement
# validation is positive after fees/slippage).
WEATHER_STRATEGY_ENABLED=false
WEATHER_MIN_EDGE=0.10
WEATHER_MIN_CONFIDENCE=0.70
WEATHER_MAX_SPREAD_BPS=180
WEATHER_MIN_TOP_DEPTH=25
WEATHER_FORECAST_TTL_SEC=900
WEATHER_REQUEST_TIMEOUT_SEC=10
WEATHER_MAX_MARKETS=40
T2_BARBELL_TAIL_BUDGET_PCT=0.15
T2_BARBELL_TAIL_RELAXED_MULTIPLIER=0.85
# T2 平仓后同市场重入冷却（秒），跨重启持久化到 RECENT_EXITS_STATE_FILE
# 默认 86400 = 24h；shadow / 小额阶段可缩到 1800 让样本量更快积累
T2_POST_EXIT_COOLDOWN_SEC=86400
T2_RECENT_EXITS_STATE_FILE=data/telemetry/recent_exits.json

# ---- T3 Flow Bias（每市场 taker_yes_share 数据底座，Becker 2025 跟进） ----
# 当前为 telemetry-only，数据量足够后会驱动 T3 quote-side 选边
T3_FLOW_BIAS_ENABLED=true
T3_FLOW_BIAS_WINDOW_SEC=3600
T3_FLOW_BIAS_MIN_TRADES=20
T3_FLOW_BIAS_STRONG_THRESHOLD=0.55
# Weight of aggregated taker_yes_share as synthetic inventory pressure
# when steering maker quotes. 0.0 = telemetry only, 0.5 = recommended,
# 1.0 = treat as full inventory load.
T3_FLOW_BIAS_INVENTORY_WEIGHT=0.5
T3_FLOW_STATE_FILE=data/telemetry/flow_state.json

# ---- Shadow Mode（roadmap §三-阶段 1：实盘前必须跑完的模拟阶段） ----
# 当 ARB_DRY_RUN=true 时启用：所有 T0/T2/T3 模拟成交写到
# data/telemetry/<date>.virtual_fills.ndjson（13 字段：side / price / size /
# order_type / is_maker / fee / slippage / intended_price / decision_context / result …）
# 每 cycle 末扫一遍 pending 模拟 maker 单：若对手价已穿越限价则 flip 到 FILLED
# 这里设置 maker 单挂出后必须经过的最小等待秒数（模拟队列位置损耗）
SHADOW_MAKER_FILL_LATENCY_SEC=2.0

# ---- 自动量化输入热加载 ----
# 总编排脚本会通过进程环境强制 bot 读取这些文件；手动启动时也建议保留。
LOGICAL_CONSTRAINTS_FILE=data/quant_inputs/logical_constraints.json
EVENT_BASELINES_FILE=data/quant_inputs/event_baselines.json
WALLET_ALPHA_PROFILES_FILE=data/quant_inputs/wallet_profiles.json
WALLET_ALPHA_OBSERVATIONS_FILE=data/quant_inputs/wallet_observations.json
# 只能给 shadow/dry-run 开启；总编排脚本会让 live 强制为 false。
WALLET_ALPHA_CANDIDATE_SHADOW_ENABLED=false
# live 单实例内的候选钱包 shadow-only 验证通道；不触发真钱下单。
WALLET_ALPHA_SHADOW_VALIDATION_ENABLED=true
WALLET_ALPHA_SHADOW_MAX_SIGNALS_PER_CYCLE=5
WALLET_ALPHA_SHADOW_MAX_EXEC_MS_PER_CYCLE=250

# ---- Polymarket Taker Fee Rate ----
# 当前 Polymarket 实际 taker fee 为 0（费率开关在 contract 层），但为安全裕度
# 留出默认 0.05；如果你确认要按零费跑，请同时设 LIVE_ALLOW_ZERO_TAKER_FEE=true
POLYMARKET_TAKER_FEE_RATE=0.005

# ---- Tick 录制（回测数据采集）----
# 开启后将 WS 订单簿快照写入 NDJSON 文件
# 服务器连续观测建议打开
TICK_RECORD_ENABLED=false
# 输出目录（自动创建）
TICK_RECORD_DIR=data/ticks

# ---- 事件遥测录制（机会/交易/风控）----
# 服务器连续观测建议打开
TELEMETRY_RECORD_ENABLED=false
TELEMETRY_RECORD_DIR=data/telemetry
# P2-telemetry: 后台线程异步写 NDJSON，主循环只付 JSON 编码 + 入队成本，
# 不再阻塞在 fsync 上。队列满时丢弃最旧事件以保留最新调试信息。
TELEMETRY_ASYNC_WRITE=true
TELEMETRY_ASYNC_QUEUE_SIZE=10000

# ---- Data 定期清理（避免长期运行占满磁盘）----
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INTERVAL_SEC=3600
DATA_TICKS_RETENTION_DAYS=7
DATA_TICKS_MAX_GB=5
DATA_TELEMETRY_RETENTION_DAYS=14
DATA_TELEMETRY_MAX_GB=2
DATA_RESEARCH_CACHE_RETENTION_DAYS=14
DATA_RESEARCH_CACHE_MAX_GB=1
DATA_BACKTEST_RETENTION_DAYS=30
DATA_BACKTEST_MAX_GB=2

# ---- 监控仪表盘 ----
DASHBOARD_ENABLED=false
DASHBOARD_PORT=8077

# ---- 日志 ----
# 生产建议保持 INFO；httpx/httpcore 请求日志会自动降到 WARNING
LOG_LEVEL=INFO
LOG_FILE=arb_bot.log

# ---- WebSocket 实时数据 ----
# 是否启用 WebSocket 订单簿推送（替代纯 REST 轮询）
WS_ENABLED=true
# 同时追踪的最大市场数（每个市场订阅 YES/NO 两个 token）
# 提高 WS 覆盖；原 12 时命中率仅 ~20%，REST fallback 过多导致 T0 延迟。
# 官方 changelog 2025-05-28 已移除 100 token 订阅上限。瓶颈在客户端：
# websockets 库默认 max_size=1MB，订阅完成后服务端按 initial_dump=true（默认）
# 一次性 dump 全簿，token 多时单包超 1MB → 客户端主动 1009 关闭 → 死循环重连。
# websocket_feed.py 已给 connect() 设 max_size=16MB，理论上可支撑数千 token。
# 若要上调 WS_MAX_MARKETS，记得同步看 ARB_HOT_MARKET_POOL_SIZE，二者匹配才不
# 浪费 WS 槽位。
WS_MAX_MARKETS=30
# 每隔多少扫描周期重新评估并切换目标市场
WS_REFRESH_CYCLES=200
# mid price 喂入 VolEstimator 的间隔（秒）
WS_VOL_FEED_INTERVAL_SEC=60

# ---- LLM 配置（供逻辑规则筛选等离线/扫描工具使用，主循环不再用 LLM 做交易决策）----
# Provider: openai / anthropic / ollama / deepseek / gemini
AI_PROVIDER=openai
AI_API_KEY=
# 自定义 API 端点（留空用 provider 默认值）
# DeepSeek: https://api.deepseek.com
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
# Ollama:   http://localhost:11434
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 随机性/发散度
AI_TEMPERATURE=0.0

# ---- TypeSafe Jev（System One 打分模型，仅旁路 worker 使用，主循环不调用）----
# 影子打标：python scripts/shadow_typesafe_baselines.py scan
# API key 在 https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# pin 具体版本；jev-latest 会漂移，校准阈值随之失效
TYPESAFE_MODEL=jev-1.13.0
# 客户端令牌桶限速（官方 1,200 RPM ≈ 20 RPS，且"可能随时调整"，留余量）
TYPESAFE_RPS=10
# 单次请求超时 / 429·529 重试次数
TYPESAFE_TIMEOUT_SEC=10
TYPESAFE_MAX_RETRIES=3
# 自定义端点（留空用 https://api.typesafe.ai）
TYPESAFE_BASE_URL=

# ---- Research Signal ----
# 是否启用研究信号聚合
# 服务器连续观测建议打开，便于后续复盘为什么有/没有信号
RESEARCH_SIGNAL_ENABLED=false
# 研究信号时间窗口（秒）
RESEARCH_SIGNAL_WINDOW_SEC=86400
# 每轮最多保留的研究信号条数
RESEARCH_SIGNAL_MAX_ITEMS=5
# 研究信号缓存 TTL（秒）
RESEARCH_SIGNAL_CACHE_TTL_SEC=300
# 研究信号磁盘缓存目录
RESEARCH_SIGNAL_CACHE_DIR=data/research_signal
# 由 research-feeds-auto worker 写入的 RSS feeds 文件（自动化模式下无需手动配置）
RESEARCH_SIGNAL_FEEDS_FILE=data/quant_inputs/research_feeds.json
# 额外 HTTP JSON 源，JSON list，适合接 public APIs / APILayer 等
RESEARCH_SIGNAL_HTTP_JSON_SOURCES=
# Crypto macro-sentiment collector (Fear & Greed). Free / no auth /
# 1-row-per-crypto-topic. Surfaces in research_overlay; not a hard gate.
RESEARCH_SIGNAL_CRYPTO_MACRO_ENABLED=true
# Manifold Markets prediction-market collector. Free / no auth.
# Returns binary-market crowd probability per topic; tier-2 source,
# main lift for politics / geopolitics / sports / awards where news
# RSS is thin. Stance: prob >= 0.60 bullish, <= 0.40 bearish.
RESEARCH_SIGNAL_MANIFOLD_ENABLED=true

# ---- Backtest ----
# 是否启用回测相关状态展示
BACKTEST_ENABLED=false
# 回测数据目录
BACKTEST_DATA_DIR=data/backtest
# 默认回测数据集名称
BACKTEST_DEFAULT_DATASET=default
# 回测执行模型附加滑点（bps）
BACKTEST_SLIPPAGE_BPS=5
# 回测报告输出目录
BACKTEST_REPORTS_DIR=research/backtest/output

# ---- T3 流动性奖励带（CLOB /rewards/markets）----
# 读市场的 rewards_max_spread（cent），换算成价格空间半宽 δ 约束 maker
# 报价，使挂单真正落在计分区间内。关掉即回到"不知道奖励带"的历史行为。
MAKER_REWARDS_ENABLED=true
# 奖励参数缓存 TTL（秒）。参数按天变化，不需要频繁拉。
MAKER_REWARDS_TTL_SEC=900
# 拉取失败/无数据的负缓存 TTL（秒），避免对无奖励市场每周期重试
MAKER_REWARDS_NEGATIVE_TTL_SEC=300
MAKER_REWARDS_TIMEOUT_SEC=5
# 单周期最多为多少个新市场排队预热（后台线程消费，不阻塞扫描）
MAKER_REWARDS_PREFETCH_PER_CYCLE=20
# true = 只在有奖励带的市场做市（默认 false，不改变现有覆盖面）
MAKER_REWARDS_ONLY=false

# ---- T3 挂单计分校验（CLOB /orders-scoring）----
# 挂在带内 != 真计分。scoring_ratio 写入 risk_events 的
# maker_scoring_audit 行，是"T3 到底有没有在赚奖励"的客观指标。
MAKER_SCORING_AUDIT_ENABLED=true
MAKER_SCORING_AUDIT_INTERVAL_SEC=60
# 连续未计分超过 grace 秒后是否撤单（默认只观测不动作）
MAKER_SCORING_CANCEL_UNSCORED=false
MAKER_SCORING_UNSCORED_GRACE_SEC=90

# ---- user 频道 WebSocket（自己的订单/成交推送）----
# 开启后成交即时回写风险敞口与退出管理器，而不是等下一个扫描周期的
# REST 轮询。REST 轮询保留为兜底，两条路径走同一段落地逻辑。
# 需要 L2 凭证；未配置时自动从交易客户端取，取不到则退回纯轮询。
USER_WS_ENABLED=true
USER_WS_QUEUE_SIZE=2000
USER_WS_MAX_EVENTS_PER_CYCLE=500

# ---- UPDOWN 结算口径现货源（Polymarket RTDS）----
# Binance 是流动性口径，UPDOWN 按 Polymarket 自己的价格源结算。
#   off / shadow / primary
#   shadow（默认）= 定价仍走 Binance，只产出 basis telemetry
#   primary       = 定价用 RTDS，数据过期时自动回落 Binance
# crypto_prices 的 payload 字段名尚未拿到权威样本，先用 shadow 观测
# 数据连续性与 basis 分布，再决定是否切 primary。
T2_UPDOWN_RTDS_MODE=shadow
T2_UPDOWN_RTDS_STALENESS_SEC=30
T2_UPDOWN_RTDS_CHAINLINK=false
T2_UPDOWN_BASIS_LOG_INTERVAL_SEC=300
# 两源偏离超过该 bps 时告警
T2_UPDOWN_BASIS_ALERT_BPS=50

# ---- T1 跨平台配对实体一致性否决 ----
# 手写配对最危险的失败模式是"配错了"：阈值/日期/方向不同的两个市场，
# poly_yes + kalshi_no < 1 看起来仍像无风险套利。只否决不建对；
# 任一侧缺问题原文（配对表的 poly_question / kalshi_title）就放行。
CROSS_PLATFORM_ENTITY_VETO_ENABLED=true
# 词元 Jaccard 重叠下限，0=关闭（跨平台措辞差异大，容易误伤）
CROSS_PLATFORM_MIN_TOKEN_OVERLAP=0

# ---- T3 抗狙击 ----
# 阈值单位是 tick 而非 bps：1 tick 在 0.50 是 200bps、在 0.05 是 2000bps，
# 用 bps 会让低价市场永久暂停、高价市场形同虚设。
T3_ANTI_SNIPE_ENABLED=true
# 单次 mid 相对上一次原始 mid 跳变超过该 tick 数 → 暂停该 token 报价
T3_ANTI_SNIPE_JUMP_TICKS=3
T3_ANTI_SNIPE_JUMP_PAUSE_SEC=20
# 暂停解除后要求连续 N 次观测的移动都在 stable band 内才恢复
T3_ANTI_SNIPE_STABLE_TICKS_REQUIRED=2
T3_ANTI_SNIPE_STABLE_BAND_TICKS=1
# 报价锚点 = 中位数(抗单点异常) + EMA(抗抖动)；alpha=0 关闭 EMA
T3_ANTI_SNIPE_EMA_ALPHA=0.3
T3_ANTI_SNIPE_MID_HISTORY=7
# 成交后冷却：刚被吃说明对手方可能有信息优势
T3_ANTI_SNIPE_POST_FILL_COOLDOWN_SEC=15
# 单次报价移动上限（tick），0=不限制
T3_ANTI_SNIPE_MAX_CHASE_TICKS=2
