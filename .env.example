# ============================================================
# Polymarket 套利机器人配置
# 复制为 .env 并填写真实值（.env 已在 .gitignore 中）
# ============================================================

# ---- 钱包与认证 ----
PRIVATE_KEY=
POLYMARKET_FUNDER=
# 签名类型: 0=EOA, 1=Magic/Email, 2=Browser/Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=2

# ---- CLOB / Gamma 端点 ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

# ---- 套利参数 ----
# 最小套利利润（美元）低于此值不执行
ARB_MIN_EDGE_USD=0.005
# 最小套利利润率（%）低于此值不执行
ARB_MIN_EDGE_PCT=0.3
# 单笔最大下单量（USDC）
ARB_MAX_ORDER_SIZE_USDC=50.0
# 默认下单量（USDC）
ARB_DEFAULT_ORDER_SIZE_USDC=10.0
# 主循环扫描间隔（秒）
ARB_SCAN_INTERVAL_SEC=5
# Gamma API 拉取市场的批量大小
ARB_MARKET_FETCH_LIMIT=100
# 是否只扫描不执行（dry run 模式）
ARB_DRY_RUN=true
# 最小市场流动性筛选（USDC）
ARB_MIN_LIQUIDITY=1000
# 最小24h交易量筛选（USDC）
ARB_MIN_VOLUME_24H=500

# ---- 风险管理 ----
# 最大同时持仓数量
RISK_MAX_OPEN_POSITIONS=10
# 单市场最大敞口（USDC）
RISK_MAX_EXPOSURE_PER_MARKET=100.0
# 全局最大敞口（USDC）
RISK_MAX_TOTAL_EXPOSURE=500.0
# 最大单日亏损（USDC），触发后停止交易
RISK_MAX_DAILY_LOSS=50.0
# 连续失败次数上限，触发后暂停
RISK_MAX_CONSECUTIVE_FAILURES=5

# ---- Telegram 通知 ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_ARB_FOUND=true
TELEGRAM_NOTIFY_ON_TRADE=true
TELEGRAM_NOTIFY_ON_ERROR=true
TELEGRAM_NOTIFY_COOLDOWN_SEC=30

# ---- 监控仪表盘 ----
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8077

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=arb_bot.log
