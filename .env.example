# ============================================================
# Polymarket 套利机器人配置
# 复制为 .env 并填写真实值（.env 已在 .gitignore 中）
# ============================================================

# ---- 钱包与认证 ----
PRIVATE_KEY=
POLYMARKET_FUNDER=
# 签名类型: 0=EOA, 1=Magic/Email, 2=Browser/Gnosis Safe
POLYMARKET_SIGNATURE_TYPE=2

# ---- CLOB / Gamma 端点 ----
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

# ---- 套利参数 ----
# 最小套利利润（美元）低于此值不执行
ARB_MIN_EDGE_USD=0.005
# 最小套利利润率（%）低于此值不执行
ARB_MIN_EDGE_PCT=0.3
# 单笔最大下单量（USDC）
ARB_MAX_ORDER_SIZE_USDC=50.0
# 默认下单量（USDC）
ARB_DEFAULT_ORDER_SIZE_USDC=10.0
# 主循环扫描间隔（秒）
ARB_SCAN_INTERVAL_SEC=5
# Gamma API 拉取市场的批量大小
ARB_MARKET_FETCH_LIMIT=100
# 全市场 universe 刷新周期（秒），主循环平时只扫热池
ARB_MARKET_UNIVERSE_REFRESH_SEC=600
# 高频扫描的热市场池大小
ARB_HOT_MARKET_POOL_SIZE=80
# 高频扫描的热事件池大小
ARB_HOT_EVENT_POOL_SIZE=30
# 可选主题过滤，逗号分隔；为空表示全市场
ARB_MARKET_FOCUS_KEYWORDS=
# 是否只扫描不执行（dry run 模式）
ARB_DRY_RUN=true
# 最小市场流动性筛选（USDC）
ARB_MIN_LIQUIDITY=1000
# 最小24h交易量筛选（USDC）
ARB_MIN_VOLUME_24H=500
# 订单簿 REST 快照缓存 TTL（秒），用于缓解高频扫描时的重复拉单
ORDERBOOK_SNAPSHOT_TTL_SEC=0.5
# 手续费假设，默认用保守值避免高估利润
# Polymarket 当前按更保守的成本侧估算 taker fee
POLYMARKET_TAKER_FEE_RATE=0.02
# Kalshi 费率默认取约 0.3%，建议结合真实成交单核实
KALSHI_TAKER_FEE_RATE=0.003

# ---- 风险管理 ----
# 最大同时持仓数量
RISK_MAX_OPEN_POSITIONS=10
# 单市场最大敞口（USDC）
RISK_MAX_EXPOSURE_PER_MARKET=100.0
# 全局最大敞口（USDC）
RISK_MAX_TOTAL_EXPOSURE=500.0
# 最大单日亏损（USDC），触发后停止交易
RISK_MAX_DAILY_LOSS=50.0
# 连续失败次数上限，触发后暂停
RISK_MAX_CONSECUTIVE_FAILURES=5

# ---- Telegram 通知 ----
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_ARB_FOUND=true
TELEGRAM_NOTIFY_ON_TRADE=true
TELEGRAM_NOTIFY_ON_ERROR=true
TELEGRAM_NOTIFY_COOLDOWN_SEC=30

# ---- 波动率估算 ----
# 快速波动率窗口（分钟），默认 60
VOL_FAST_MINUTES=60
# 慢速波动率窗口（分钟），默认 360
VOL_SLOW_MINUTES=360
# 最少数据点要求，默认 20
VOL_MIN_BARS=20

# ---- Edge 引擎 ----
# 最小 edge 阈值（基点），低于此值不触发
EDGE_MIN_BPS=100
# 最大可接受 spread（基点）
EDGE_MAX_SPREAD_BPS=500
# 最小置信度
EDGE_MIN_CONFIDENCE=0.4

# ---- Tick 录制（回测数据采集）----
# 开启后将 WS 订单簿快照写入 NDJSON 文件
TICK_RECORD_ENABLED=false
# 输出目录（自动创建）
TICK_RECORD_DIR=data/ticks

# ---- 事件遥测录制（机会/交易/AI/风控）----
TELEMETRY_RECORD_ENABLED=false
TELEMETRY_RECORD_DIR=data/telemetry

# ---- Data 定期清理（避免长期运行占满磁盘）----
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INTERVAL_SEC=3600
DATA_TICKS_RETENTION_DAYS=7
DATA_TICKS_MAX_GB=5
DATA_TELEMETRY_RETENTION_DAYS=14
DATA_TELEMETRY_MAX_GB=2
DATA_RESEARCH_CACHE_RETENTION_DAYS=14
DATA_RESEARCH_CACHE_MAX_GB=1
DATA_BACKTEST_RETENTION_DAYS=30
DATA_BACKTEST_MAX_GB=2

# ---- 监控仪表盘 ----
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8077

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FILE=arb_bot.log

# ---- WebSocket 实时数据 ----
# 是否启用 WebSocket 订单簿推送（替代纯 REST 轮询）
WS_ENABLED=true
# 同时追踪的最大市场数（每个市场订阅 YES/NO 两个 token）
WS_MAX_MARKETS=3
# 每隔多少扫描周期重新评估并切换目标市场
WS_REFRESH_CYCLES=200
# mid price 喂入 VolEstimator 的间隔（秒）
WS_VOL_FEED_INTERVAL_SEC=60

# ---- AI 决策引擎 ----
AI_ENABLED=false
# Provider: openai / anthropic / ollama / deepseek / gemini
AI_PROVIDER=openai
AI_API_KEY=
# 自定义 API 端点（留空用 provider 默认值）
# DeepSeek: https://api.deepseek.com
# Gemini:   https://generativelanguage.googleapis.com/v1beta/openai
# Ollama:   http://localhost:11434
AI_API_BASE=
AI_MODEL=gpt-4o
AI_TEMPERATURE=0.1
# AI 评估周期（秒），越小越灵敏但成本越高
AI_EVAL_INTERVAL_SEC=30
# 日 API 成本上限（USD）
AI_MAX_COST_PER_DAY=5.0
# AI 是否可以动态调整风控参数
AI_OVERRIDE_RISK=false
# AI 降级后自动恢复等待时间（秒），避免连续亏损后永久停用
AI_AUTO_RECOVER_SEC=1800

# ---- Research Signal ----
# 是否启用研究信号聚合与 AI 上下文增强
RESEARCH_SIGNAL_ENABLED=false
# 研究信号时间窗口（秒）
RESEARCH_SIGNAL_WINDOW_SEC=86400
# 每轮最多保留的研究信号条数
RESEARCH_SIGNAL_MAX_ITEMS=5
# 研究信号缓存 TTL（秒）
RESEARCH_SIGNAL_CACHE_TTL_SEC=300
# 研究信号磁盘缓存目录
RESEARCH_SIGNAL_CACHE_DIR=data/research_signal
# 额外 RSS 源，格式 name=https://host/rss?q={query},name2=https://...
RESEARCH_SIGNAL_EXTRA_RSS_FEEDS=
# 是否启用本地知识库（轻量 RAG）
RESEARCH_SIGNAL_KNOWLEDGE_ENABLED=false
# 本地知识库目录，读取其中所有 *.jsonl
RESEARCH_SIGNAL_KNOWLEDGE_DIR=data/research_signal/knowledge
# 每个 topic 最多命中的知识库条数
RESEARCH_SIGNAL_KNOWLEDGE_MAX_MATCHES=3

# ---- Backtest ----
# 是否启用回测相关状态展示
BACKTEST_ENABLED=false
# 回测数据目录
BACKTEST_DATA_DIR=data/backtest
# 默认回测数据集名称
BACKTEST_DEFAULT_DATASET=default
# 回测执行模型附加滑点（bps）
BACKTEST_SLIPPAGE_BPS=5
# 回测报告输出目录
BACKTEST_REPORTS_DIR=research/backtest/output
